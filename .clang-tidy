---
# zonix-plus clang-tidy configuration

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-signal-handler,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-static-cast-downcast,
  misc-non-copyable-objects,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-use-auto,
  modernize-use-bool-literals,
  modernize-use-default-member-init,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-no-int-to-ptr,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-container-size-empty,
  readability-else-after-return,
  readability-identifier-naming,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-make-member-function-const,
  readability-non-const-parameter,
  readability-qualified-auto,
  # readability-redundant-member-init,
  readability-redundant-string-init,
  readability-static-accessed-through-instance,
  readability-uppercase-literal-suffix,

WarningsAsErrors: 'readability-identifier-naming'

HeaderFilterRegex: '(kernel|boot|include|arch)/.*\.(h|hpp)$'

CheckOptions:
  # --- Namespace: lowercase ---
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # --- Class / Struct: CamelCase (PascalCase) ---
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase

  # --- Enum: CamelCase ---
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Project aliases are types; preserve only canonical runtime/container names.
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(u?int(8|16|32|64|ptr)_t|size_t|va_list|p[dt]e_t|iterator|const_iterator|reverse_iterator|const_reverse_iterator|value_type|size_type|difference_type|pointer|const_pointer|reference|const_reference)$'
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '^(p[dt]e_t|va_list)$'

  # --- Functions / Methods: lower_case ---
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case

  # --- Variables: lower_case ---
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # --- Member variables: lower_case (default, no suffix) ---
  - key: readability-identifier-naming.MemberCase
    value: lower_case

  # --- Public member variables: lower_case, no suffix (struct-style) ---
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case

  # --- Private member variables: lower_case with _ suffix (class-style) ---
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'

  # --- Protected member variables: lower_case with _ suffix (class-style) ---
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'

  # Singleton mutable state is private and follows the same member suffix.
  - key: readability-identifier-naming.ClassMemberCase
    value: lower_case
  - key: readability-identifier-naming.ClassMemberSuffix
    value: '_'

  # Scope determines constant naming; local constexpr values remain locals.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstexprCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case

  # --- Global variables: lower_case ---
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case

  # --- Macros: UPPER_CASE ---
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # Types and compile-time values have distinct forms.
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.ValueTemplateParameterCase
    value: UPPER_CASE

  # --- modernize-use-auto: conservative (only iterators etc.) ---
  - key: modernize-use-auto.MinTypeNameLength
    value: '12'

  # --- modernize-use-default-member-init: use braces {} ---
  - key: modernize-use-default-member-init.UseAssignment
    value: 'false'

  # --- readability-implicit-bool-conversion ---
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 'true'
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: 'true'

  # --- readability-braces-around-statements ---
  - key: readability-braces-around-statements.ShortStatementLines
    value: '2'
...
